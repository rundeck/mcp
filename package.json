{
  "name": "rundeck-mcp",
  "version": "1.0.0",
  "description": "MCP server for Rundeck documentation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rundeck-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "concurrently -n typescript,server -c blue,green \"tsc --watch --preserveWatchOutput\" \"nodemon\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "validate": "npm run build && npm test && node dist/__tests__/run-all-validations.js",
    "inspect": "npm run build && mcp-inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "rundeck",
    "documentation"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "marked": "^12.0.0",
    "yaml": "2.8.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.0"
  },
  "overrides": {
    "hono": ">=4.12.25"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "concurrently": "9.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.5.0"
  }
}
