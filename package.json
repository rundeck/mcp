{
  "name": "@rundeck/mcp",
  "version": "0.0.1",
  "description": "MCP server for Rundeck documentation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rundeck-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "concurrently -n typescript,server -c blue,green \"tsc --watch --preserveWatchOutput\" \"nodemon\"",
    "postinstall": "node scripts/download-docs.mjs",
    "docs:update": "node scripts/download-docs.mjs --force",
    "test": "env -u RUNDECK_URL -u RUNDECK_TOKEN -u RUNDECK_INSTANCES -u RUNDECK_API_VERSION NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "env -u RUNDECK_URL -u RUNDECK_TOKEN -u RUNDECK_INSTANCES -u RUNDECK_API_VERSION NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "validate": "npm run build && npm test && node dist/__tests__/run-all-validations.js",
    "inspect": "npm run build && mcp-inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "rundeck",
    "documentation"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "marked": "^12.0.0",
    "yaml": "2.8.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.0"
  },
  "overrides": {
    "hono": "4.12.29",
    "fast-uri": "3.1.3",
    "@modelcontextprotocol/sdk": {
      "ajv": "8.20.0"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.22.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "concurrently": "9.2.4",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.5.0"
  }
}
