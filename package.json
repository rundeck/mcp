{
  "name": "@rundeck/mcp",
  "version": "0.0.1",
  "description": "MCP server for Rundeck documentation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rundeck-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "scripts/download-docs.mjs",
    "scripts/rundeck-connect.sh"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "concurrently -n typescript,server -c blue,green \"tsc --watch --preserveWatchOutput\" \"nodemon\"",
    "postinstall": "node scripts/download-docs.mjs",
    "docs:update": "node scripts/download-docs.mjs --force",
    "test": "env -u RUNDECK_URL -u RUNDECK_TOKEN -u RUNDECK_INSTANCES -u RUNDECK_API_VERSION NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "env -u RUNDECK_URL -u RUNDECK_TOKEN -u RUNDECK_INSTANCES -u RUNDECK_API_VERSION NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "validate": "npm run build && npm test && node dist/__tests__/run-all-validations.js",
    "inspect": "npm run build && mcp-inspector --config ./inspector.config.json --server rundeck-mcp"
  },
  "keywords": [
    "mcp",
    "rundeck",
    "documentation"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "marked": "^18.0.0",
    "yaml": "2.9.0",
    "zod": "^4.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "overrides": {
    "hono": "4.12.34",
    "fast-uri": "4.1.2",
    "ip-address": "10.3.1",
    "@hono/node-server": "^2.0.5",
    "rolldown": "1.2.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "10.0.3",
    "jest": "^30.0.0",
    "jest-util": "^30.0.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.5.0"
  }
}
