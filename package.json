{
  "name": "rundeck-mcp",
  "version": "1.0.0",
  "description": "MCP server for Rundeck documentation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rundeck-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:watch": "tsc --watch",
    "dev:server": "nodemon",
    "dev:inspector": "npm run build && mcp-inspector node dist/index.js",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "validate": "npm run build && npm test",
    "validate:subagent": "npm run build && node dist/__tests__/subagent-validation.js",
    "validate:tools": "npm run build && node dist/__tests__/tools-validation.js",
    "validate:plugins": "npm run build && npm test -- src/__tests__/tools/plugins.test.ts",
    "validate:inspector": "npm run build && node dist/__tests__/mcp-inspector-validation.js",
    "validate:browser": "npm run build && node dist/__tests__/browser-validation.js",
    "validate:all": "npm run validate && npm run validate:subagent && npm run validate:tools && npm run validate:inspector && npm run validate:browser",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest src/__tests__/integration/"
  },
  "keywords": [
    "mcp",
    "rundeck",
    "documentation"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "marked": "^12.0.0",
    "yaml": "^2.4.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.0"
  }
}
